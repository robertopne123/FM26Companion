<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Gaffer</RootNamespace>
    <AssemblyName>Gaffer</AssemblyName>
    <Description>Gaffer — AI coaching companion for Football Manager 2026.</Description>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameDir Condition="'$(GameDir)' == ''">GAMEDIR_NOT_SET</GameDir>
    <NoWarn>$(NoWarn);CS0234;CS0246</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Version sourced from the FM26 Thunderstore BepInEx pack README:
      BepInEx-Unity.IL2CPP-win-x64-6.0.0-be.738+af0cba7.zip
    -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.738" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)/BepInEx/interop/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)/BepInEx/interop/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)/BepInEx/interop/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)/BepInEx/interop/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
