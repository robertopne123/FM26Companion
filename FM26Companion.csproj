<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Gaffer</RootNamespace>
    <AssemblyName>Gaffer</AssemblyName>
    <Description>Gaffer — AI coaching companion for Football Manager 2026.</Description>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameDir Condition="'$(GameDir)' == ''">GAMEDIR_NOT_SET</GameDir>
    <GameInteropDir Condition="Exists('$(GameDir)/BepInEx/interop')">$(GameDir)/BepInEx/interop</GameInteropDir>
    <GameInteropDir Condition="'$(GameInteropDir)' == '' and Exists('$(GameDir)/Contents/MacOS/BepInEx/interop')">$(GameDir)/Contents/MacOS/BepInEx/interop</GameInteropDir>
    <NoWarn>$(NoWarn);CS0234;CS0246</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Version sourced from the FM26 Thunderstore BepInEx pack README:
      BepInEx-Unity.IL2CPP-win-x64-6.0.0-be.738+af0cba7.zip
    -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.738" />
  </ItemGroup>

  <!--
    SDK-style projects compile every *.cs file by default.
    Keep legacy deleted files from old checkouts out of compilation.
  -->
  <ItemGroup>
    <Compile Remove="src/UI/GafferPanel.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameInteropDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameInteropDir)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameInteropDir)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameInteropDir)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameInteropDir)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameInterop" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(GameInteropDir)' == ''"
      Text="Game interop folder not found. Set -p:GameDir to either (a) FM26.app/Contents/MacOS or (b) FM26.app. Then launch FM26 once so BepInEx generates BepInEx/interop/." />
    <Error
      Condition="'$(GameInteropDir)' != '' and !Exists('$(GameInteropDir)/UnityEngine.CoreModule.dll')"
      Text="UnityEngine.CoreModule.dll not found under $(GameInteropDir). Launch FM26 once with BepInEx installed to generate interop assemblies." />
  </Target>
</Project>
