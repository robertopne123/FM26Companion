<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FM26Companion</RootNamespace>
    <AssemblyName>FM26Companion</AssemblyName>
    <Description>Gaffer — AI companion mod for Football Manager 2026</Description>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      GameDir must be set at build time, e.g.:
        dotnet build -p:GameDir="/Users/you/Library/Application Support/Steam/steamapps/common/Football Manager 2026/Football Manager 2026.app/Contents/MacOS"
      Or export it in your shell:
        export GameDir="/path/to/Football Manager 2026.app/Contents/MacOS"
    -->
    <GameDir Condition="'$(GameDir)' == ''">GAMEDIR_NOT_SET</GameDir>

    <!--
      Suppress missing-reference warnings during development before interop DLLs
      have been generated. Remove these once your local interop folder is populated.
    -->
    <NoWarn>$(NoWarn);CS0234;CS0246</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      BepInEx.Unity.IL2CPP is the BepInEx 6 package for IL2CPP games.
      It transitively pulls in:
        - BepInEx.Core          (config, logging, patching infrastructure)
        - Il2CppInterop.Runtime (bridge between injected Mono runtime and IL2CPP game)
        - HarmonyX              (runtime method patching)

      IL2CPP note: BepInEx injects a Mono/.NET 6 runtime alongside FM26's IL2CPP
      native code. Your plugin C# runs in that Mono runtime. Il2CppInterop generates
      proxy DLLs (interop/) that let your Mono code call into the IL2CPP side via
      pinvoke-style thunks. This is fundamentally different from BepInEx Mono where
      the game itself runs in Mono alongside your plugin.
    -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.697" />
  </ItemGroup>

  <!--
    Unity engine interop DLLs — generated by BepInEx on first FM26 launch.
    Location: <GameDir>/BepInEx/interop/

    These are machine-generated shims; do NOT commit them to source control.
    They will not exist until you have run FM26 with BepInEx installed at least once.

    The IL2CPP-specific types you get from here (e.g. Il2CppSystem.Object,
    Il2CppInterop.Runtime.Il2CppObjectBase) look like normal C# types but are
    thin wrappers that marshal calls across the Mono↔IL2CPP boundary at runtime.
  -->
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)/BepInEx/interop/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)/BepInEx/interop/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)/BepInEx/interop/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.EventSystems">
      <HintPath>$(GameDir)/BepInEx/interop/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      FM26 game assemblies — generated by Il2CppDumper (see README.md).
      Uncomment each one as you identify and need it.
    -->
    <!--
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)/BepInEx/interop/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    -->
  </ItemGroup>

</Project>
