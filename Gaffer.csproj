<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <!-- net6.0 confirmed by BepInEx.Unity.IL2CPP.csproj in BepInEx/master.
         BepInEx 6 runs a .NET 6 CLR alongside the IL2CPP native process. -->
    <AssemblyName>Gaffer</AssemblyName>
    <RootNamespace>Gaffer</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Required: Il2CppInterop uses unsafe pointer operations throughout -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Single output DLL dropped into BepInEx/plugins/ -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    FM26 game directory — set this before building.

    Mac:
      export FM26_GAME_DIR="$HOME/Library/Application Support/Steam/steamapps/common/Football Manager 2026/Football Manager 2026.app/Contents/MacOS"

    Or pass on the command line:
      dotnet build -p:FM26GameDir="/path/to/FM26/Contents/MacOS"

    The BepInEx/interop/ subfolder is generated by Cpp2IL the first time BepInEx
    runs against FM26. Run the game once with BepInEx installed before building
    against FM26 types. Unity assemblies are included in this interop dump.
  -->
  <PropertyGroup>
    <FM26GameDir Condition="'$(FM26GameDir)' == '' and '$(FM26_GAME_DIR)' != ''">$(FM26_GAME_DIR)</FM26GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      BepInEx 6.0.0-pre.2 — confirmed working on FM26 (IL2CPP x64).
      Provides: BasePlugin, ManualLogSource, ConfigFile, PluginInfo.
      Versions confirmed from github.com/BepInEx/BepInEx master branch csproj.
      Sourced from https://nuget.bepinex.dev/v3/index.json (see nuget.config).
    -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-pre.2" />

    <!--
      Il2CppInterop.Runtime 1.5.1-ci.829 — confirmed version from BepInEx master.
      Used directly in plugin code for:
        - ClassInjector.RegisterTypeInIl2Cpp<T>() (MonoBehaviour injection)
        - Il2CppSystem.* types when crossing the managed/native boundary
    -->
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.1-ci.829" />
  </ItemGroup>

  <!--
    FM26 + Unity interop assemblies, generated by Cpp2IL from the game binary.
    These provide all Unity (UnityEngine.UI, UnityEngine.EventSystems, etc.) and
    FM26 (Football Manager IL2CPP types) references.

    If FM26GameDir is not set the project will show missing-reference warnings for
    Unity UI types used in GafferUI.cs — this is expected. Set the path and rebuild.
  -->
  <ItemGroup Condition="'$(FM26GameDir)' != '' and Exists('$(FM26GameDir)/BepInEx/interop')">
    <Reference Include="$(FM26GameDir)/BepInEx/interop/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    FM26 BepInEx core assemblies — needed when referencing BepInEx types not in NuGet packages.
    Only included when game dir is set and core exists.
  -->
  <ItemGroup Condition="'$(FM26GameDir)' != '' and Exists('$(FM26GameDir)/BepInEx/core')">
    <Reference Include="$(FM26GameDir)/BepInEx/core/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
