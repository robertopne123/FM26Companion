<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      BepInEx publishes pre-release packages on their own feed.
      This must be listed BEFORE nuget.org so that the IL2CPP packages resolve correctly.
    -->
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
