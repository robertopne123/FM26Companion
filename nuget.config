<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- BepInEx packages: BepInEx.Unity.IL2CPP, Il2CppInterop.*, HarmonyX, etc. -->
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
    <!-- Samboy: Cpp2IL packages referenced by BepInEx IL2CPP runtime -->
    <add key="Samboy" value="https://nuget.samboy.dev/v3/index.json" />
    <!-- Standard packages: System.Text.Json, Microsoft.Extensions.Logging, etc. -->
    <add key="NuGet.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
